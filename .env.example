# Image hasil GitHub Actions / GHCR
ERP_IMAGE=ghcr.io/withabdul/erpnext-berkoding:latest

# Domain yang dipakai Traefik
ERP_DOMAIN=erp.example.com

# Nama site ERPNext di dalam volume sites
FRAPPE_SITE_NAME_HEADER=site.localhost

# Volume production saat ini; jangan diubah kecuali memang mau instance baru
MARIADB_VOLUME=erpnext-docker_mariadb_data
SITES_VOLUME=erpnext-docker_sites
LOGS_VOLUME=erpnext-docker_logs

# Ganti dengan secret yang kuat sebelum deploy
MYSQL_ROOT_PASSWORD=change-this-root-password
SITES_DB_ROOT_PASSWORD=change-this-sites-password
